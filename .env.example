# Salin ke .env lewat ./setup.sh (jangan di-commit).
# Password TIDAK ada di sini; setup.sh menaruhnya di ./secrets/.

# Domain publik dari Cloudflare Tunnel, tanpa https://
WP_DOMAIN=wp.baharma.my.id

# Port lokal (hanya 127.0.0.1). Route tunnel: HTTP -> localhost:<WP_PORT>
WP_PORT=8090

# Prefix tabel acak, diisi otomatis oleh setup.sh
WP_TABLE_PREFIX=

TZ=Asia/Jakarta
