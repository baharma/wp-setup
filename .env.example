# Salin ke .env (cp .env.example .env), sesuaikan, lalu ./setup.sh.
# Jangan di-commit. Password tidak ada di sini; setup.sh menaruhnya di ./secrets/.

# Nama proyek Docker; harus beda tiap situs (jadi prefix container & volume).
COMPOSE_PROJECT_NAME=wp-blog

# Nama database & user MySQL jadi wp_<SITE_NAME>. Huruf kecil, angka, _ saja.
SITE_NAME=blog

# Domain publik dari Cloudflare Tunnel, tanpa https://
WP_DOMAIN=wp.baharma.my.id

# Port lokal (hanya 127.0.0.1), harus beda tiap situs: 8090, 8091, 8092, ...
# Route tunnel: HTTP -> localhost:<WP_PORT>
WP_PORT=8090

# Prefix tabel acak, diisi otomatis oleh setup.sh kalau kosong
WP_TABLE_PREFIX=

TZ=Asia/Jakarta
