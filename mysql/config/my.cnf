[mysqld]
# Binary log hanya perlu untuk replikasi; tanpa ini disk terus bertambah.
disable-log-bin
# Hemat RAM sekitar 100-200 MB.
performance-schema = OFF
# Protokol X (port 33060) tidak dipakai WordPress.
mysqlx = OFF

# Dipakai bersama semua aplikasi; naikkan kalau aplikasinya bertambah banyak.
innodb-buffer-pool-size = 256M
max-connections = 100

skip-name-resolve
local-infile = 0

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
